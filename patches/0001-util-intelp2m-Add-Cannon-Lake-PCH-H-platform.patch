diff --git a/util/intelp2m/platforms/cnlh/cnlh.go b/util/intelp2m/platforms/cnlh/cnlh.go
new file mode 100644
index 00000000..5a2dcecd
--- /dev/null
+++ b/util/intelp2m/platforms/cnlh/cnlh.go
@@ -0,0 +1,52 @@
+package cnlh
+
+import (
+	"strings"
+
+	"review.coreboot.org/coreboot.git/util/intelp2m/logs"
+	"review.coreboot.org/coreboot.git/util/intelp2m/platforms/cnl"
+	"review.coreboot.org/coreboot.git/util/intelp2m/platforms/common"
+	"review.coreboot.org/coreboot.git/util/intelp2m/platforms/common/register/bits"
+)
+
+// Cannon Lake PCH-H (300-series desktop chipsets, CNP-H) uses the same pad
+// configuration registers as Cannon Lake PCH-LP, but the PADRSTCFG mapping
+// differs: every GPP community uses 00 = RSMRST, 01 = DEEP, 10 = PLTRST,
+// while only the GPD community uses 00 = PWROK, 01 = DEEP, 10 = PLTRST,
+// 11 = RSMRST (see rst_map and rst_map_gpd in
+// src/soc/intel/cannonlake/gpio_cnp_h.c).
+var GPPGroups = append([]string{
+	"ESPI_CLK_LOOPBK", "GSPI0_CLK_LOOPBK", "GSPI1_CLK_LOOPBK",
+}, cnl.GPPGroups...)
+
+var remapping = common.ResetSources{
+	0b00: bits.RstCfgRSMRST << bits.DW0PadRstCfg,
+	0b01: bits.RstCfgDEEP << bits.DW0PadRstCfg,
+	0b10: bits.RstCfgPLTRST << bits.DW0PadRstCfg,
+}
+
+type BasePlatform struct {
+	// based on the Cannon Lake PCH-LP platform
+	cnl.BasePlatform
+}
+
+func InitBasePlatform(dw0, dw0mask uint32, dw1, dw1mask uint32) BasePlatform {
+	return BasePlatform{cnl.InitBasePlatform(dw0, dw0mask, dw1, dw1mask)}
+}
+
+func GetPlatform(dw0, dw1 uint32) common.PlatformIf {
+	p := InitBasePlatform(dw0, cnl.DW0Mask, dw1, cnl.DW1Mask)
+	return &p
+}
+
+// Override BasePlatform.RemapResetSource()
+func (p *BasePlatform) RemapResetSource(m *common.Macro) {
+	if strings.HasPrefix(m.GetPadId(), "GPD") {
+		// The GPD community uses the common PWROK/DEEP/PLTRST/RSMRST
+		// encoding, no remapping required.
+		return
+	}
+	if err := p.UpdateResetSource(remapping); err != nil {
+		logs.Errorf("remap reset source for %s: %v", m.GetPadId(), err)
+	}
+}
diff --git a/util/intelp2m/platforms/cnlh/cnlh_test.go b/util/intelp2m/platforms/cnlh/cnlh_test.go
new file mode 100644
index 00000000..0a591e9a
--- /dev/null
+++ b/util/intelp2m/platforms/cnlh/cnlh_test.go
@@ -0,0 +1,60 @@
+package cnlh_test
+
+import (
+	"testing"
+
+	"review.coreboot.org/coreboot.git/util/intelp2m/config/p2m"
+	"review.coreboot.org/coreboot.git/util/intelp2m/platforms/common"
+	"review.coreboot.org/coreboot.git/util/intelp2m/platforms/test"
+)
+
+func TestGenMacro(t *testing.T) {
+	p2m.Config.Platform = p2m.CannonH
+	test.Suite{
+		{
+			// PADRSTCFG = 00: RSMRST in all GPP communities on PCH-H
+			Pad: test.Pad{ID: "GPP_A1", DW0: 0x00000400, DW1: 0x00000000, Ownership: common.Acpi},
+			Macro: test.Macro{
+				Short: "PAD_CFG_NF(GPP_A1, NONE, RSMRST, NF1),",
+				Long:  "_PAD_CFG_STRUCT(GPP_A1, PAD_FUNC(NF1) | PAD_RESET(RSMRST), 0),",
+			},
+		},
+		{
+			Pad: test.Pad{ID: "GPP_B12", DW0: 0x80000400, DW1: 0x00000000, Ownership: common.Acpi},
+			Macro: test.Macro{
+				Short: "PAD_CFG_NF(GPP_B12, NONE, PLTRST, NF1),",
+				Long:  "_PAD_CFG_STRUCT(GPP_B12, PAD_FUNC(NF1) | PAD_RESET(PLTRST), 0),",
+			},
+		},
+		{
+			Pad: test.Pad{ID: "GPP_G3", DW0: 0x00000400, DW1: 0x00000000, Ownership: common.Acpi},
+			Macro: test.Macro{
+				Short: "PAD_CFG_NF(GPP_G3, NONE, RSMRST, NF1),",
+				Long:  "_PAD_CFG_STRUCT(GPP_G3, PAD_FUNC(NF1) | PAD_RESET(RSMRST), 0),",
+			},
+		},
+		{
+			Pad: test.Pad{ID: "GPP_E9", DW0: 0x40000400, DW1: 0x00000000, Ownership: common.Acpi},
+			Macro: test.Macro{
+				Short: "PAD_CFG_NF(GPP_E9, NONE, DEEP, NF1),",
+				Long:  "_PAD_CFG_STRUCT(GPP_E9, PAD_FUNC(NF1) | PAD_RESET(DEEP), 0),",
+			},
+		},
+		{
+			// PADRSTCFG = 00: PWROK in the GPD community
+			Pad: test.Pad{ID: "GPD4", DW0: 0x00000400, DW1: 0x00000000, Ownership: common.Acpi},
+			Macro: test.Macro{
+				Short: "PAD_CFG_NF(GPD4, NONE, PWROK, NF1),",
+				Long:  "_PAD_CFG_STRUCT(GPD4, PAD_FUNC(NF1), 0),",
+			},
+		},
+		{
+			// PADRSTCFG = 11: RSMRST in the GPD community
+			Pad: test.Pad{ID: "GPD2", DW0: 0xc0000400, DW1: 0x00000000, Ownership: common.Acpi},
+			Macro: test.Macro{
+				Short: "PAD_CFG_NF(GPD2, NONE, RSMRST, NF1),",
+				Long:  "_PAD_CFG_STRUCT(GPD2, PAD_FUNC(NF1) | PAD_RESET(RSMRST), 0),",
+			},
+		},
+	}.Run(t, "INTEL-CANNON-LAKE-PCH-H/RESET-SOURCE-MAPPING")
+}
