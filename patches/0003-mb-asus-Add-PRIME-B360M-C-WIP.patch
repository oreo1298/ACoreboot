diff --git a/src/mainboard/asus/b360m-c/bootblock.c b/src/mainboard/asus/b360m-c/bootblock.c
new file mode 100644
index 00000000..a41c1d93
--- /dev/null
+++ b/src/mainboard/asus/b360m-c/bootblock.c
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <bootblock_common.h>
+#include <device/pnp_ops.h>
+#include <superio/nuvoton/common/nuvoton.h>
+#include <superio/nuvoton/nct6793d/nct6793d.h>
+
+#include "include/gpio.h"
+
+#define GLOBAL_DEV	PNP_DEV(0x2e, 0)
+#define SERIAL_DEV	PNP_DEV(0x2e, NCT6793D_SP1)
+#define LDN12_DEV	PNP_DEV(0x2e, NCT6793D_LDN12)
+
+void bootblock_mainboard_early_init(void)
+{
+	/*
+	 * Multi-function pin selection. These are the read-modify-write
+	 * operations done by the NCT6793D PEI module of the vendor firmware
+	 * (BIOS 3202). Do not change them without the board schematics.
+	 */
+	nuvoton_pnp_enter_conf_state(GLOBAL_DEV);
+	pnp_unset_and_set_config(GLOBAL_DEV, 0x27, 1 << 2, 0);
+	pnp_unset_and_set_config(GLOBAL_DEV, 0x2a, 1 << 6, 0);
+	pnp_unset_and_set_config(GLOBAL_DEV, 0x27, 1 << 4, 1 << 4);
+	pnp_unset_and_set_config(GLOBAL_DEV, 0x2f, 1 << 1, 0);
+	pnp_unset_and_set_config(GLOBAL_DEV, 0x2a, 3 << 0, 0);
+	pnp_set_logical_device(LDN12_DEV);
+	pnp_unset_and_set_config(LDN12_DEV, 0xeb, 3 << 4, 0);
+	nuvoton_pnp_exit_conf_state(GLOBAL_DEV);
+
+	/* COM1 header (UART A). Also routes UART A to its pins (CR 0x2a[7]). */
+	nuvoton_enable_serial(SERIAL_DEV, CONFIG_TTYS0_BASE);
+}
+
+void bootblock_mainboard_init(void)
+{
+	/* The vendor firmware applies its GPIO table early in PEI, too. */
+	mainboard_configure_gpios();
+}
