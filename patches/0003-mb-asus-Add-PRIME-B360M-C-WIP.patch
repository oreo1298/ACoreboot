+	/* GPD2 - LAN_WAKE# */
+	_PAD_CFG_STRUCT(GPD2,
+		PAD_FUNC(NF1) | PAD_RESET(RSMRST) | PAD_IRQ_ROUTE(SCI) | PAD_BUF(TX_DISABLE),
+		0),
+	/* GPD3 - PRWBTN# */
+	_PAD_CFG_STRUCT(GPD3,
+		PAD_FUNC(NF1) | PAD_RESET(RSMRST) | PAD_BUF(TX_DISABLE),
+		PAD_PULL(UP_20K)),
+	/* GPD4 - SLP_S3# */
+	_PAD_CFG_STRUCT(GPD4, PAD_FUNC(NF1) | PAD_RESET(RSMRST) | PAD_BUF(RX_DISABLE), 0),
+	/* GPD5 - SLP_S4# */
+	_PAD_CFG_STRUCT(GPD5, PAD_FUNC(NF1) | PAD_RESET(RSMRST) | PAD_BUF(RX_DISABLE), 0),
+	PAD_CFG_GPI_TRIG_OWN(GPD6, NONE, PLTRST, OFF, DRIVER),
