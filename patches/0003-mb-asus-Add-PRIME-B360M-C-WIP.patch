+-- SPDX-License-Identifier: GPL-2.0-or-later
+
+with HW.GFX.GMA;
+with HW.GFX.GMA.Display_Probing;
+
+use HW.GFX.GMA;
+use HW.GFX.GMA.Display_Probing;
+
+private package GMA.Mainboard is
+
+   -- Port mapping from the vendor VBT:
+   --   DDI B: DP1 (DP++), DDI C: DP2 (DP++), DDI D: HDMI,
+   --   DDI E: DP to VGA converter (D-Sub port)
+   ports : constant Port_List :=
+     (HDMI3,
+      DP1,
+      DP2,
+      HDMI1,
+      HDMI2,
+      Analog,
+      others => Disabled);
+
+end GMA.Mainboard;
diff --git a/src/mainboard/asus/b360m-c/gpio.c b/src/mainboard/asus/b360m-c/gpio.c
new file mode 100644
index 00000000..934a2727
--- /dev/null
+++ b/src/mainboard/asus/b360m-c/gpio.c
@@ -0,0 +1,321 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <gpio.h>
+#include "include/gpio.h"
+
+/*
+ * Pad configuration taken from the GPIO_INIT_CONFIG table of the vendor
+ * firmware (ASUS BIOS 3202, board PEIM 2accd044-284c-432f-9a1a-4cde31036c9f)
+ * and converted with `util/intelp2m -p cnl-h`. Every Cannon Point PCH-H pad
+ * is listed in the vendor table, so every pad is listed here.
+ */
