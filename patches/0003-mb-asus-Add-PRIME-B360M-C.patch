diff --git a/src/mainboard/asus/b360m-c/mainboard.c b/src/mainboard/asus/b360m-c/mainboard.c
new file mode 100644
index 00000000..ad91d9f0
--- /dev/null
+++ b/src/mainboard/asus/b360m-c/mainboard.c
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <commonlib/memory_info.h>
+#include <smbios.h>
+#include <stdio.h>
+
+/*
+ * Use the slot names printed on the board. A DIMM in DIMM_B2 is reported
+ * as channel 1, DIMM 1; the other slots follow the same scheme.
+ */
+void smbios_fill_dimm_locator(const struct dimm_info *dimm, struct smbios_type17 *t)
+{
+	char locator[40];
+
+	snprintf(locator, sizeof(locator), "DIMM_%c%d",
+		 'A' + dimm->channel_num, dimm->dimm_num + 1);
+	t->device_locator = smbios_add_string(t->eos, locator);
+
+	snprintf(locator, sizeof(locator), "BANK %d", dimm->bank_locator);
+	t->bank_locator = smbios_add_string(t->eos, locator);
+}
