+	_PAD_CFG_STRUCT(GPP_A10,
+		PAD_FUNC(NF1) | PAD_RESET(PLTRST) | PAD_BUF(RX_DISABLE),
+		PAD_PULL(DN_20K)),
+	PAD_CFG_GPI_TRIG_OWN(GPP_A11, NONE, PLTRST, OFF, DRIVER),
+	PAD_CFG_GPI_TRIG_OWN(GPP_A12, NONE, PLTRST, OFF, DRIVER),
