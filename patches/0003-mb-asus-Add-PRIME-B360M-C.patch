+ * firmware (ASUS BIOS 3202, board PEIM 2accd044-284c-432f-9a1a-4cde31036c9f)
+ * and converted with `util/intelp2m -p cnl-h`. Every Cannon Point PCH-H pad
+ * is listed in the vendor table, so every pad is listed here.
+ */
+static const struct pad_config gpio_table[] = {
+	/* GPP_A */
+	/* GPP_A0 - RCIN# */
+	_PAD_CFG_STRUCT(GPP_A0, PAD_FUNC(NF1) | PAD_RESET(PLTRST) | PAD_BUF(TX_DISABLE), 0),
+	/* GPP_A1 - LAD0 */
+	PAD_CFG_NF(GPP_A1, UP_20K, PLTRST, NF1),
+	/* GPP_A2 - LAD1 */
+	PAD_CFG_NF(GPP_A2, UP_20K, PLTRST, NF1),
+	/* GPP_A3 - LAD2 */
+	PAD_CFG_NF(GPP_A3, UP_20K, PLTRST, NF1),
+	/* GPP_A4 - LAD3 */
+	PAD_CFG_NF(GPP_A4, UP_20K, PLTRST, NF1),
