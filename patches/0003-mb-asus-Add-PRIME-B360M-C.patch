+	PAD_CFG_GPI_TRIG_OWN(GPP_D8, NONE, PLTRST, OFF, DRIVER),
+	PAD_CFG_GPI_TRIG_OWN(GPP_D9, NONE, PLTRST, OFF, DRIVER),
+	PAD_CFG_GPI_TRIG_OWN(GPP_D10, NONE, PLTRST, OFF, DRIVER),
