+	PAD_CFG_GPI_TRIG_OWN(GPP_A20, NONE, PLTRST, OFF, DRIVER),
+	PAD_CFG_GPI_TRIG_OWN(GPP_A21, NONE, PLTRST, OFF, DRIVER),
+	PAD_CFG_GPI_TRIG_OWN(GPP_A22, NONE, PLTRST, OFF, DRIVER),
+	PAD_CFG_GPI_TRIG_OWN(GPP_A23, NONE, PLTRST, OFF, DRIVER),
+
+	/* GPP_B */
