+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <device/azalia_device.h>
+
+/*
+ * Realtek ALC887 verb table, taken verbatim from the HD Audio verb table
+ * of the vendor firmware (BIOS 3202). The vendor firmware has no verb
+ * table for the Intel display audio codec, so none is provided here.
+ */
+static const u32 realtek_alc887_verbs[] = {
+	AZALIA_SUBVENDOR(0, 0x104386ca),
+	AZALIA_RESET(1),
+	AZALIA_PIN_CFG(0, 0x11, 0x40330000),	/* not a jack (vendor value) */
+	AZALIA_PIN_CFG(0, 0x12, AZALIA_PIN_CFG_NC(0)),
+	AZALIA_PIN_CFG(0, 0x14, 0x01014010),	/* rear line out, green */
+	AZALIA_PIN_CFG(0, 0x15, 0x01813040),	/* rear line in, blue */
+	AZALIA_PIN_CFG(0, 0x16, AZALIA_PIN_CFG_NC(0)),
+	AZALIA_PIN_CFG(0, 0x17, AZALIA_PIN_CFG_NC(0)),
+	AZALIA_PIN_CFG(0, 0x18, 0x01a1904f),	/* rear mic in, pink */
+	AZALIA_PIN_CFG(0, 0x19, 0x02a19050),	/* front panel mic in, pink */
+	AZALIA_PIN_CFG(0, 0x1a, 0x99130120),	/* MONO_OUT header (speaker amp) */
+	AZALIA_PIN_CFG(0, 0x1b, 0x02214030),	/* front panel headphone, green */
+	AZALIA_PIN_CFG(0, 0x1c, AZALIA_PIN_CFG_NC(0)),
+	AZALIA_PIN_CFG(0, 0x1d, 0x40200001),	/* not a jack (vendor value) */
+	AZALIA_PIN_CFG(0, 0x1e, AZALIA_PIN_CFG_NC(0)),
+	AZALIA_PIN_CFG(0, 0x1f, AZALIA_PIN_CFG_NC(0)),
+	/* Vendor processing coefficient 0x07 = 0x09c8, written twice by vendor firmware */
+	AZALIA_VERB_4B(0, 0x20, AZALIA_SET_COEFF_INDEX, 0x0007),
+	AZALIA_VERB_4B(0, 0x20, AZALIA_SET_PROCESSING_COEFF, 0x09c8),
+	AZALIA_VERB_4B(0, 0x20, AZALIA_SET_COEFF_INDEX, 0x0007),
+	AZALIA_VERB_4B(0, 0x20, AZALIA_SET_PROCESSING_COEFF, 0x09c8),
+};
+
+const u32 pc_beep_verbs[] = {};
+
+struct azalia_codec mainboard_azalia_codecs[] = {
+	{
+		.name         = "Realtek ALC887",
+		.vendor_id    = 0x10ec0887,
+		.subsystem_id = 0x104386ca,
+		.address      = 0,
+		.verbs        = realtek_alc887_verbs,
+		.verb_count   = ARRAY_SIZE(realtek_alc887_verbs),
+	},
+};
+
+AZALIA_ARRAY_SIZES;
