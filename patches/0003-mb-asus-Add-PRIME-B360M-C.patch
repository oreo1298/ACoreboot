diff --git a/src/mainboard/asus/b360m-c/devicetree.cb b/src/mainboard/asus/b360m-c/devicetree.cb
new file mode 100644
index 00000000..790d40b1
--- /dev/null
+++ b/src/mainboard/asus/b360m-c/devicetree.cb
@@ -0,0 +1,173 @@
+## SPDX-License-Identifier: GPL-2.0-only
+
+chip soc/intel/cannonlake
+	register "eist_enable" = "true"
+
+	# GPE configuration, taken from asrock/h370m-itx_ac. The vendor GPIO table
+	# routes GPP_D23 to SCI, but neither the vendor DSDT nor coreboot has a
+	# handler for it.
+	register "gpe0_dw0" = "GPP_C"
+	register "gpe0_dw1" = "GPP_K"
+	register "gpe0_dw2" = "GPP_E"
+
+	# The CLKSRC/CLKREQ to root port mapping is not known yet, so run every
+	# PCIe reference clock free and do not use CLKREQ#.
+	register "PcieClkSrcUsage" = "{
+		[0]  = PCIE_CLK_FREE, [1]  = PCIE_CLK_FREE,
+		[2]  = PCIE_CLK_FREE, [3]  = PCIE_CLK_FREE,
+		[4]  = PCIE_CLK_FREE, [5]  = PCIE_CLK_FREE,
+		[6]  = PCIE_CLK_FREE, [7]  = PCIE_CLK_FREE,
+		[8]  = PCIE_CLK_FREE, [9]  = PCIE_CLK_FREE,
+		[10] = PCIE_CLK_FREE, [11] = PCIE_CLK_FREE,
+		[12] = PCIE_CLK_FREE, [13] = PCIE_CLK_FREE,
+		[14] = PCIE_CLK_FREE, [15] = PCIE_CLK_FREE,
+	}"
+	register "PcieClkSrcClkReq" = "{
+		[0]  = PCIE_CLK_NOTUSED, [1]  = PCIE_CLK_NOTUSED,
+		[2]  = PCIE_CLK_NOTUSED, [3]  = PCIE_CLK_NOTUSED,
+		[4]  = PCIE_CLK_NOTUSED, [5]  = PCIE_CLK_NOTUSED,
+		[6]  = PCIE_CLK_NOTUSED, [7]  = PCIE_CLK_NOTUSED,
+		[8]  = PCIE_CLK_NOTUSED, [9]  = PCIE_CLK_NOTUSED,
+		[10] = PCIE_CLK_NOTUSED, [11] = PCIE_CLK_NOTUSED,
+		[12] = PCIE_CLK_NOTUSED, [13] = PCIE_CLK_NOTUSED,
+		[14] = PCIE_CLK_NOTUSED, [15] = PCIE_CLK_NOTUSED,
+	}"
+
+	device domain 0 on
+		device ref peg0 on
+			smbios_slot_desc "SlotTypePciExpressGen3X16" "SlotLengthLong"
+				"PCIEX16" "SlotDataBusWidth16X"
+		end
+		device ref igpu on end
+		device ref thermal on end
+		device ref xhci on
+			# Connector names from the vendor SMBIOS tables; their mapping to
+			# PCH port numbers is assumed (TODO: verify with lsusb -t). The
+			# over-current pin mapping is not known, so OC is not used.
+			register "usb2_ports" = "{
+				[0]  = USB2_PORT_MID(OC_SKIP),	/* U31G2_12, rear */
+				[1]  = USB2_PORT_MID(OC_SKIP),	/* U31G2_12, rear */
+				[2]  = USB2_PORT_MID(OC_SKIP),	/* U31G2_34, rear */
+				[3]  = USB2_PORT_MID(OC_SKIP),	/* U31G2_34, rear */
+				[4]  = USB2_PORT_MID(OC_SKIP),	/* U31G1_56 header */
+				[5]  = USB2_PORT_MID(OC_SKIP),	/* U31G1_56 header */
+				[6]  = USB2_PORT_MID(OC_SKIP),	/* USB78 header */
+				[7]  = USB2_PORT_MID(OC_SKIP),	/* USB78 header */
+				[8]  = USB2_PORT_MID(OC_SKIP),	/* LAN_USB910, rear */
+				[9]  = USB2_PORT_MID(OC_SKIP),	/* LAN_USB910, rear */
+				[10] = USB2_PORT_MID(OC_SKIP),	/* USB1112 header */
+				[11] = USB2_PORT_MID(OC_SKIP),	/* USB1112 header */
+				[12] = USB2_PORT_EMPTY,
+				[13] = USB2_PORT_EMPTY,
+			}"
+			register "usb3_ports" = "{
+				[0] = USB3_PORT_DEFAULT(OC_SKIP),	/* U31G2_12, rear */
+				[1] = USB3_PORT_DEFAULT(OC_SKIP),	/* U31G2_12, rear */
+				[2] = USB3_PORT_DEFAULT(OC_SKIP),	/* U31G2_34, rear */
+				[3] = USB3_PORT_DEFAULT(OC_SKIP),	/* U31G2_34, rear */
+				[4] = USB3_PORT_DEFAULT(OC_SKIP),	/* U31G1_56 header */
+				[5] = USB3_PORT_DEFAULT(OC_SKIP),	/* U31G1_56 header */
+				[6] = USB3_PORT_EMPTY,
+				[7] = USB3_PORT_EMPTY,
+				[8] = USB3_PORT_EMPTY,
+				[9] = USB3_PORT_EMPTY,
+			}"
+		end
+		device ref heci1 on end
+		device ref sata on
+			# SATA6G_1 .. SATA6G_6; M.2_1 in SATA mode shares SATA6G_2
+			register "SataPortsEnable" = "{
+				[0] = 1,
+				[1] = 1,
+				[2] = 1,
+				[3] = 1,
+				[4] = 1,
+				[5] = 1,
+			}"
+		end
+
+		# Root ports are assigned to HSIO lanes by the soft straps. On hardware
+		# FSP keeps RP6 (ASM1083), RP7, RP8 (x1), RP9 and RP21 (x4, the two
+		# M.2 sockets) and disables the rest; all are left enabled here so
+		# that FSP decides from the straps.
+		device ref pcie_rp1 on end
+		device ref pcie_rp2 on end
+		device ref pcie_rp3 on end
+		device ref pcie_rp4 on end
+		device ref pcie_rp5 on end
+		device ref pcie_rp6 on end	# ASMedia ASM1083 PCIe to PCI bridge
+		# The vendor SMBIOS names RP4/RP5 for the x1 slots, but those ports
+		# have no lanes on hardware; RP7/RP8 are the remaining x1 ports.
+		# TODO: confirm which slot is which with a card.
+		device ref pcie_rp7 on
+			register "PcieRpSlotImplemented[6]" = "true"
+			smbios_slot_desc "SlotTypePciExpressGen3X1" "SlotLengthShort"
+				"PCIEX1_1" "SlotDataBusWidth1X"
+		end
+		device ref pcie_rp8 on
+			register "PcieRpSlotImplemented[7]" = "true"
+			smbios_slot_desc "SlotTypePciExpressGen3X1" "SlotLengthShort"
+				"PCIEX1_2" "SlotDataBusWidth1X"
+		end
+		device ref pcie_rp9 on end	# M.2_1, x4 (NVMe trained at 8 GT/s x4)
+		device ref pcie_rp10 on end
+		device ref pcie_rp11 on end
+		device ref pcie_rp12 on end
+		device ref pcie_rp13 on end
+		device ref pcie_rp14 on end
+		device ref pcie_rp15 on end
+		device ref pcie_rp16 on end
+		device ref pcie_rp17 on end
+		device ref pcie_rp18 on end
+		device ref pcie_rp19 on end
+		device ref pcie_rp20 on end
+		device ref pcie_rp21 on end	# M.2_2, x4 (the only other x4 port)
+		device ref pcie_rp22 on end
+		device ref pcie_rp23 on end
+		device ref pcie_rp24 on end
+
+		device ref lpc_espi on
+			# Super I/O hardware monitor (vendor DSDT: IOHW 0x290, IOHL 0x10)
+			register "gen1_dec" = "LPC_IO(0x290, 0x10)"
+
+			chip superio/common
+				device pnp 2e.0 on	# passes SIO base addr to SSDT gen
+					chip superio/nuvoton/nct6793d
+						device pnp 2e.1 on	# Parallel port (LPT header)
+							io  0x60 = 0x378
+							irq 0x70 = 7
+							drq 0x74 = 4	# no DMA
+						end
+						device pnp 2e.2 on	# UART A (COM1 header)
+							io  0x60 = 0x3f8
+							irq 0x70 = 4
+						end
+						device pnp 2e.3 on	# UART B (COM2 header)
+							io  0x60 = 0x2f8
+							irq 0x70 = 3
+						end
+						device pnp 2e.5 on	# PS/2 keyboard and mouse
+							io  0x60 = 0x60
+							io  0x62 = 0x64
+							irq 0x70 = 1
+							irq 0x72 = 12
+						end
+						device pnp 2e.6 off end	# CIR, no header on this board
+						# Hardware monitor: base address only, the fan
+						# control registers keep their power-on defaults.
+						device pnp 2e.b on
+							io  0x60 = 0x290
+						end
+						device pnp 2e.e off end	# CIR wake-up
+					end
+				end
+			end
+		end
+		device ref hda on
+			register "PchHdaAudioLinkHda" = "1"
+		end
+		device ref smbus on end
+		device ref fast_spi on end
+		device ref gbe on end
+	end
+end
diff --git a/src/mainboard/asus/b360m-c/dsdt.asl b/src/mainboard/asus/b360m-c/dsdt.asl
