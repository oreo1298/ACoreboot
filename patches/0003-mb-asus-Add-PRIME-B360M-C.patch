+	_PAD_CFG_STRUCT(GPP_A5, PAD_FUNC(NF1) | PAD_RESET(PLTRST) | PAD_BUF(RX_DISABLE), 0),
+	/* GPP_A6 - SERIRQ */
+	PAD_CFG_NF(GPP_A6, NONE, PLTRST, NF1),
+	PAD_CFG_GPI_TRIG_OWN(GPP_A7, NONE, PLTRST, OFF, DRIVER),
+	/* GPP_A8 - CLKRUN# */
+	_PAD_CFG_STRUCT(GPP_A8, PAD_FUNC(NF1) | PAD_RESET(PLTRST) | PAD_BUF(TX_DISABLE), 0),
+	/* GPP_A9 - CLKOUT_LPC0 */
+	_PAD_CFG_STRUCT(GPP_A9,
+		PAD_FUNC(NF1) | PAD_RESET(PLTRST) | PAD_BUF(RX_DISABLE),
+		PAD_PULL(DN_20K)),
