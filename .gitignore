# coreboot tree is cloned by scripts/setup.sh and never committed
/coreboot/
# build logs / scratch
/logs/
/build/
# derived from board-data/vendor/*.CAP by scripts/extract_blobs.sh
/board-data/vendor/*-spi.bin
/board-data/vendor/regions/
/board-data/vendor/uefi/
# out/ is committed (final ROMs); intermediate build trees are not
__pycache__/
*.pyc
# Variant E is built locally by scripts/build.sh, not committed
/out/*_E_edk2_fspgop_ME_HAP_UNVERIFIED.*
