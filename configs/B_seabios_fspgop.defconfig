# Variant B: SeaBIOS + FSP GOP (display fallback, expected to drive VGA too)
CONFIG_PAYLOAD_SEABIOS=y
CONFIG_SEABIOS_STABLE=y
# CONFIG_MAINBOARD_USE_LIBGFXINIT is not set
CONFIG_RUN_FSP_GOP=y
CONFIG_GENERIC_LINEAR_FRAMEBUFFER=y
# Options (debug_level, power_on_after_fail, me_state) live in CMOS; change
# them with nvramtool. me_state=Disable soft-disables the ME via HECI.
CONFIG_USE_OPTION_TABLE=y
