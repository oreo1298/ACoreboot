# Common settings for every ASUS PRIME B360M-C variant (scripts/build.sh).
# @TOP@ is replaced with the repository path.
CONFIG_VENDOR_ASUS=y
CONFIG_BOARD_ASUS_B360M_C=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_IFD_BIN_PATH="@TOP@/blobs/descriptor.bin"
CONFIG_HAVE_ME_BIN=y
CONFIG_ME_BIN_PATH="@TOP@/blobs/me.bin"
CONFIG_HAVE_GBE_BIN=y
CONFIG_GBE_BIN_PATH="@GBE@"
# Console on the Super I/O COM1 header, 115200 8N1, POST codes on port 0x80
CONFIG_CONSOLE_SERIAL=y
CONFIG_CONSOLE_SERIAL_115200=y
CONFIG_TTYS0_BASE=0x3f8
CONFIG_POST_IO=y
CONFIG_DEFAULT_CONSOLE_LOGLEVEL_7=y
CONFIG_CONSOLE_CBMEM=y
# Keep the vendor flash descriptor byte-for-byte (no ifdtool --unlock)
CONFIG_DO_NOT_TOUCH_DESCRIPTOR_REGION=y
# Options (debug_level, power_on_after_fail, me_state) live in CMOS; change
# them with nvramtool. me_state=Disable soft-disables the ME via HECI.
CONFIG_USE_OPTION_TABLE=y
